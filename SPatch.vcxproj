  <Target Name="ValidateFinalReleaseRequest"
          BeforeTargets="PrepareForBuild"
          Condition="'$(FinalRelease)'=='true'">
    <Error Condition="'$(Configuration)'!='Release' or '$(Platform)'!='x64'"
           Text="SPatch FinalRelease requires Configuration=Release and Platform=x64." />
  </Target>
  <Target Name="ValidateSmaaSource" BeforeTargets="PrepareForBuild">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)tools\Verify-SmaaSource.ps1&quot;" />
  </Target>
  <Target Name="AcquireFinalBuildLock"
          BeforeTargets="PrepareForBuild"
          DependsOnTargets="ValidateFinalReleaseRequest"
          Condition="'$(FinalRelease)'=='true' and '$(Configuration)'=='Release' and '$(Platform)'=='x64'">
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(ProjectDir)tools\Build-SPatchRelease.ps1&quot; -BuildLockAction Acquire -LockToken &quot;$(SPatchFinalBuildLockToken)&quot;" />
  </Target>
  <Target Name="ValidateDeployRequest"
          BeforeTargets="PrepareForBuild"
          DependsOnTargets="ValidateFinalReleaseRequest"
          Condition="'$(DeployGameArtifacts)'=='true'">
    <Error Condition="'$(Configuration)'!='Release' or '$(Platform)'!='x64'"
           Text="SPatch deployment requires Configuration=Release and Platform=x64." />
    <Error Condition="'$(FinalRelease)'!='true'"
           Text="SPatch deployment requires FinalRelease=true; diagnostic builds cannot be installed as end-user artifacts." />
    <Error Condition="!Exists('$(NormalizedGameDir)sdhdship.exe')"
           Text="SPatch deployment target is not a Sleeping Dogs: Definitive Edition folder: $(GameDir)" />
    <Error Condition="!Exists('$(AsiLoaderPath)')"
           Text="SPatch deployment requires an x64 dinput8.dll ASI-loader candidate beside sdhdship.exe: $(AsiLoaderPath)" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)tools\Test-SPatchDeployTarget.ps1&quot; -GameExecutablePath &quot;$(NormalizedGameDir)sdhdship.exe&quot; -BuildInfoPath &quot;$(ProjectDir)src\BuildInfo.h&quot; -AsiLoaderPath &quot;$(AsiLoaderPath)&quot;" />
  </Target>
  <Target Name="VerifyBeforeDeploy">
    <Error Text="VerifyBeforeDeploy is not a public entry point. Invoke Build or Rebuild with Release|x64, FinalRelease=true, and DeployGameArtifacts=true." />
  </Target>
  <Target Name="VerifyFinalRelease">
    <Error Text="VerifyFinalRelease is not a public entry point. Invoke Build or Rebuild with Release|x64 and FinalRelease=true." />
  </Target>
  <Target Name="AssembleFinalReleasePackage">
    <Error Text="AssembleFinalReleasePackage cannot publish a pre-existing output. Invoke Build or Rebuild with Release|x64 and FinalRelease=true." />
  </Target>
  <Target Name="DeployToGame">
    <Error Text="DeployToGame cannot deploy a pre-existing output. Invoke Build or Rebuild with Release|x64, FinalRelease=true, and DeployGameArtifacts=true." />
  </Target>
  <Target Name="WriteFinalReleaseIdentity">
    <Error Text="WriteFinalReleaseIdentity cannot attest a pre-existing output. Invoke Build or Rebuild with Release|x64 and FinalRelease=true." />
  </Target>
  <Target Name="_ReleaseFinalBuildLock"
          Condition="'$(FinalRelease)'=='true' and '$(Configuration)'=='Release' and '$(Platform)'=='x64'">
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(ProjectDir)tools\Build-SPatchRelease.ps1&quot; -BuildLockAction Release -LockToken &quot;$(SPatchFinalBuildLockToken)&quot;" />
  </Target>
  <Target Name="_FinalizeCurrentFinalBuild"
          AfterTargets="Build"
          Condition="'$(FinalRelease)'=='true' and '$(Configuration)'=='Release' and '$(Platform)'=='x64'">
    <ItemGroup>
      <_FinalBuildAttestationLine Include="SPATCH_FINAL_BUILD=1" />
      <_FinalBuildAttestationLine Include="INVOCATION_ID=$(SPatchFinalBuildInvocationId)" />
      <_FinalBuildAttestationLine Include="CONFIGURATION=Release" />
      <_FinalBuildAttestationLine Include="PLATFORM=x64" />
      <_FinalBuildAttestationLine Include="FINAL_RELEASE=true" />
      <_FinalBuildAttestationLine Include="PROJECT=SPatch.vcxproj" />
      <_FinalBuildAttestationLine Include="ARTIFACT=build/Release/SPatch.asi" />
      <_FinalBuildAttestationLine Include="BUILD_LOCK_TOKEN=$(SPatchFinalBuildLockToken)" />
    </ItemGroup>
    <WriteLinesToFile File="$(FinalBuildAttestationPath)"
                      Lines="@(_FinalBuildAttestationLine)"
                      Overwrite="true"
                      Encoding="UTF-8" />
    <MSBuild Projects="$(ProjectDir)SPatchTests.vcxproj"
             Targets="Rebuild"
             RemoveProperties="OutDir;IntDir;TargetName;TargetExt;DeployGameArtifacts;GameDir"
             Properties="Configuration=Release;Platform=x64;FinalRelease=false" />
    <Exec Command="&quot;$(NormalTestsPath)&quot;" />
    <MSBuild Projects="$(ProjectDir)SPatchTests.vcxproj"
             Targets="Rebuild"
             RemoveProperties="OutDir;IntDir;TargetName;TargetExt;DeployGameArtifacts;GameDir"
             Properties="Configuration=Release;Platform=x64;FinalRelease=true" />
    <Exec Command="&quot;$(FinalTestsPath)&quot;" />
    <Delete Files="$(TargetDir)$(TargetName).pdb" />
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(ProjectDir)tools\Build-SPatchRelease.ps1&quot; -ArtifactPath &quot;$(TargetPath)&quot; -NormalTestsPath &quot;$(NormalTestsPath)&quot; -FinalTestsPath &quot;$(FinalTestsPath)&quot; -BuildAttestationPath &quot;$(FinalBuildAttestationPath)&quot; -BuildInvocationId &quot;$(SPatchFinalBuildInvocationId)&quot; -BuildLockToken &quot;$(SPatchFinalBuildLockToken)&quot;" />
    <Error Condition="!Exists('$(TargetDir)$(TargetName).final-release.sha256')"
           Text="Snapshot-bound FinalRelease identity was not published: $(TargetDir)$(TargetName).final-release.sha256" />
    <Message Condition="'$(DeployGameArtifacts)'=='true'"
             Text="Deploying current attested $(TargetPath) to $(NormalizedGameDir)" Importance="high" />
    <Exec Condition="'$(DeployGameArtifacts)'=='true'"
          Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(ProjectDir)tools\Deploy-SPatchArtifact.ps1&quot; -ArtifactPath &quot;$(TargetPath)&quot; -FinalReleaseIdentityPath &quot;$(TargetDir)$(TargetName).final-release.sha256&quot; -GameRoot &quot;$(NormalizedGameDir).&quot; -BuildInfoPath &quot;$(ProjectDir)src\BuildInfo.h&quot; -AsiLoaderPath &quot;$(AsiLoaderPath)&quot;" />
    <CallTarget Targets="_ReleaseFinalBuildLock" />
    <OnError ExecuteTargets="_ReleaseFinalBuildLock" />
  </Target>
  <Target Name="ResolvePinnedMinHook" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(ProjectDir)tools\Resolve-MinHook.ps1')"
           Text="Pinned SDmodding MinHook resolver is missing: $(ProjectDir)tools\Resolve-MinHook.ps1" />
    <Exec Condition="'$(MinHookOffline)'!='true'"
          Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\tools\Resolve-MinHook.ps1&quot; -RepoRoot &quot;$(MSBuildProjectDirectory)&quot; -MinHookRoot &quot;$(MinHookRoot)\.&quot; -Quiet" />
    <Exec Condition="'$(MinHookOffline)'=='true'"
          Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\tools\Resolve-MinHook.ps1&quot; -RepoRoot &quot;$(MSBuildProjectDirectory)&quot; -MinHookRoot &quot;$(MinHookRoot)\.&quot; -Offline -Quiet" />
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
