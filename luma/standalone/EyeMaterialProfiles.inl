[[nodiscard]] constexpr const EyeMaterialProfile* FindEyeMaterialProfile(
    const std::uint32_t material_uid) noexcept
{
    std::size_t first = 0;
    std::size_t last = kEyeMaterialProfiles.size();

    while (first < last)
    {
        const auto middle = first + ((last - first) / 2);
        if (kEyeMaterialProfiles[middle].material_uid < material_uid)
            first = middle + 1;
        else
            last = middle;
    }

    return first < kEyeMaterialProfiles.size() &&
                   kEyeMaterialProfiles[first].material_uid == material_uid
               ? &kEyeMaterialProfiles[first]
               : nullptr;
}

[[nodiscard]] constexpr bool EyeMaterialProfilesAreSortedAndUnique() noexcept
{
    for (std::size_t i = 1; i < kEyeMaterialProfiles.size(); ++i)
    {
        if (kEyeMaterialProfiles[i - 1].material_uid >=
            kEyeMaterialProfiles[i].material_uid)
            return false;
    }

    return true;
}

static_assert(kEyeIrisInnerRadius >= 0.0f);
static_assert(kEyeIrisInnerRadius < kEyeIrisOuterRadius);
static_assert(kEyeIrisOuterRadius <= 1.0f);
static_assert(EyeMaterialProfilesAreSortedAndUnique());

